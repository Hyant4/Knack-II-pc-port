import QtQuick

Canvas {
    // Original character illustration inspired by Knack's faceted relic body.
    // Drawn locally; no extracted or remote assets, no continuous animation.
    id: canvas
    implicitWidth: 340
    implicitHeight: 260
    Accessible.ignored: true
    onWidthChanged: requestPaint()
    onHeightChanged: requestPaint()
    onPaint: {
        const c = getContext("2d"); c.reset();
        const scale = Math.min(width / 340, height / 260);
        c.translate((width - 340*scale)/2, (height - 260*scale)/2);
        c.scale(scale, scale);
        function poly(points, color) {
            c.beginPath(); c.moveTo(points[0][0], points[0][1]);
            for (let i = 1; i < points.length; i++) c.lineTo(points[i][0], points[i][1]);
            c.closePath(); c.fillStyle = color; c.fill();
        }
        function shard(x,y,r) {
            poly([[x,y-r],[x+r*.7,y],[x,y+r],[x-r*.7,y]],"#e2ad5a");
            poly([[x,y-r],[x+r*.7,y],[x,y+r]],"#8c653e");
            poly([[x,y-r],[x,y+r],[x-r*.7,y]],"#ffd38a");
        }
        c.strokeStyle="#44737b"; c.lineWidth=.8;
        c.beginPath(); c.arc(184,128,107,.1,Math.PI*1.7); c.stroke();
        c.strokeStyle="#315d68";
        c.beginPath(); c.arc(184,128,121,2.6,5.3); c.stroke();
        poly([[45,215],[157,177],[310,218],[191,254]],"#1a3c47");
