#include <winuser.h>
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "tlg-probe.manifest"
// Knack II public identity. Internal target names remain compatible.
// Optional local original icon. Proprietary game artwork is never distributed here.
#ifdef KNACK2_ICON_FILE
1 ICON KNACK2_ICON_FILE
#endif

1 VERSIONINFO
FILEVERSION 0,17,7,4
PRODUCTVERSION 0,17,7,4
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x2L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Knack II PC Port contributors\0"
            VALUE "FileDescription", "Knack II PC Port Runtime\0"
            VALUE "FileVersion", "0.17.7.4\0"
            VALUE "InternalName", "knack2-runtime\0"
            VALUE "OriginalFilename", "knack2-runtime.exe\0"
            VALUE "ProductName", "Knack II PC Port\0"
            VALUE "ProductVersion", "0.17.7-rc4\0"
            VALUE "LegalCopyright", "Upstream authors credited in README.md and LICENSE files.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
